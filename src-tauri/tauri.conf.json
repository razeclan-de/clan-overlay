{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "https://raze-clan.de/",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "RazeOverlay",
    "version": "1.0.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "process": {
        "exit": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.razeclan.overlay",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Raze Overlay",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ]
  }
}
